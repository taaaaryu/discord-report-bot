DISCORD_BOT_TOKEN=
GUILD_ID=
TARGET_VOICE_CHANNEL_ID=
MINUTES_TEXT_CHANNEL_ID=

MIN_PARTICIPANTS=2
AUDIO_CHUNK_MINUTES=10
RETENTION_DAYS=7
TZ=Asia/Tokyo
MEETING_TITLE=日次会議

# Recording is always Whisper(OpenAI)
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Summary LLM provider: openai or gemini
LLM_PROVIDER=openai
OPENAI_SUMMARY_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_SUMMARY_MODEL=gemini-1.5-flash

# Runtime behavior
AUTO_START=false
START_ON_BOOT=true
